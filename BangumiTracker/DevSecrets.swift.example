import Foundation

/// Local secrets. Copy this file to `DevSecrets.swift` and fill in real values.
/// `DevSecrets.swift` is gitignored and must never be committed.
///
/// `bangumiAccessToken` is DEBUG-only (dev auto-login); release builds ignore it.
/// `oauthClientID`/`oauthClientSecret` ship in BOTH Debug and Release so OAuth
/// login + token refresh work for real users — they live in the gitignored file
/// (not in git) but are compiled into the app binary.
enum DevSecrets {
    /// Personal access token for development from https://next.bgm.tv/demo/access-token.
    /// DEBUG-only: used to auto-login during dev without going through OAuth.
    /// Leave empty to disable the dev fallback. Never ships in Release.
    static let bangumiAccessToken = ""

    /// OAuth app credentials from https://bgm.tv/dev/app — register an app with
    /// redirect URI `bangumitracker://oauth/callback`. Available in Debug AND
    /// Release. Leave both empty to keep OAuth unavailable; users fall back to
    /// pasting a personal access token.
    static let oauthClientID = ""
    static let oauthClientSecret = ""

    /// 反馈函数 URL(公网端点,非密钥)。Debug 和 Release 都会用到。Release 必填;
    /// Debug 留空时提交按钮显示「反馈服务未配置」(开发守护)。填部署后的函数 URL
    /// (如腾讯云 SCF API 网关 URL)。
    static let feedbackEndpoint = ""

    /// 可选:X-Feedback-Key 共享密钥加固。留空 = 关闭(v1 默认)。若填,则函数
    /// 环境变量 FEEDBACK_KEY 必须为相同值,否则提交被拒。
    static let feedbackKey = ""
}
